{
  "manifest_version": 2,
  "name": "PhishLink Scanner",
  "version": "1.0.0",
  "description": "Checks if a URL is a phishing link with report generated by AI model.",
  "icons": {
    "48": "icons/icon48.png",
    "96": "icons/icon96.png"
  },
  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon48.png"
    },
    "default_title": "PhishLink Scanner"
  },
  "background": {
    "scripts": ["background/background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"]
    }
  ],
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "tabs",
    "<all_urls>"
  ],
  "options_ui": {
    "page": "options/options.html",
    "browser_style": true
  }
}
